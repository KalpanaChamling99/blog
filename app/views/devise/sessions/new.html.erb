<div class='box p-6 mt-9 w-450 ml-auto mr-auto'>
  <h2 class='m-0'>Login</h2>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="pt-3">
      <%= f.label :email,class:'mt-2' %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",class:'mt-2' %>
    </div>

    <div class="pt-3">
      <%= f.label :password,class:'mt-2' %>
      <%= f.password_field :password, autocomplete: "current-password",class:'mt-2' %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="pt-5 d-flex">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me,class:'w-auto ml-1' %>
      </div>
    <% end %>

    <div class="pt-2 d-flex align-center">
      <%= f.submit "Log in",class:'btn mt-3' %>
      <div class='mt-3 ml-3'>
        <%= render "devise/shared/links" %>
      </div>
    </div>
  <% end %>

</div>

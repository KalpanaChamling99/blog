<div class='box p-6 mt-9 w-450 ml-auto mr-auto'>
  <h2 class='m-0'>Forgot your password?</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="pt-3">
      <%= f.label :email,class:'mt-2' %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",class:'mt-2' %>
    </div>

    <div class="pt-4">
      <%= f.submit "Reset Password",class:'btn' %>
    </div>
  <% end %>
</div>

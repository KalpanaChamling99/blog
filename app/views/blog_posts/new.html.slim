.blog-create-page
  .container
    h2 Add new blog
    = form_with model: @blog_post do |form|
      / -if form.object.errors.any?
      /   -form.object.errors.full_messages.each do | message |
      /     p.error-msg #{message}
     
      .form-group
        = form.label :title, "Post Title"
        = form.text_field :title, placeholder:'Enter Post title'
        - if @blog_post.errors[:title].any?
          p.error-msg= @blog_post.errors.full_messages_for(:title).first


      .form-group
        = form.label :description, "Post description"
        = form.text_area :description, placeholder:'Enter Post desc'
        
        - if @blog_post.errors[:description].any?
          p.error-msg= @blog_post.errors.full_messages_for(:description).first
      
      .form-group
        = form.label :image, "Post image"
        = form.text_area :image, placeholder:'upload'

      
      .form-group
        = form.label :category, "Post Category"
        = form.text_field :category, placeholder:'Enter Post category'
        - if @blog_post.errors[:category].any?
          p.error-msg= @blog_post.errors.full_messages_for(:category).first

      = form.submit "Add post",class:'submit-btn'
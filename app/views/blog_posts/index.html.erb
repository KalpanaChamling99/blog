<div class="container">
  <h2>Blog List </h2>
  <ul>
    <% @blog_post_list.each do |post| %>
      <li class="blog-post">
       <div class="category-section">
          <span class="category">
            <%= post.category %>
          </span>
        </div>
        <h2><%= link_to post.title,post %></h2>
        <h2 style="display:none">
          <%= link_to post.title,blog_post_path(post.id) %>
        </h2> 
        <p><%= post.description %></p>
       
      </li>
    <% end %>
  </ul>
</div>

